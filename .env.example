# Copy this file to .env before using non-demo credentials.
DATABASE_URL=sqlite:///./shopsage.db
CHROMA_PATH=./.chroma
JWT_SECRET=replace-this-with-a-long-random-value
ADMIN_EMAIL=merchant@shopsage.demo
ADMIN_PASSWORD=demo-admin-password
MODEL_PROVIDER=deterministic
MODEL_NAME=rule-based-demo
